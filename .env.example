# ================================================================
# SUPABASE (Phase 1) — point at LLG llg-platform project
# ================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                # 🚨 server-only, NEVER prefix with NEXT_PUBLIC_

# ================================================================
# APP CONFIG (Phase 1)
# ================================================================
NEXT_PUBLIC_APP_URL_CLIENT=http://llgportal.local:3000
NEXT_PUBLIC_APP_URL_ADMIN=http://ops.llgportal.local:3000
# In production these become https://llgportal.com and https://ops.legalleadsgroup.com

# ================================================================
# CRON SECURITY (Phase 1)
# Generate locally:  openssl rand -hex 32
# ================================================================
CRON_SECRET=                              # 🚨 secret

# ================================================================
# SENTRY (Phase 1)
# ================================================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=llg
SENTRY_PROJECT=llg-platform
SENTRY_AUTH_TOKEN=                        # 🚨 secret — for source map uploads on deploy

# ================================================================
# RINGCENTRAL — Phase 1 alerts only; rest in Phase 5
# ================================================================
RC_WEBHOOK_ALERTS=                        # 🚨 #llg-alerts incoming webhook URL

# ================================================================
# BRIGHTLOCAL / PSI / CALLRAIL / METRICOOL — added in Phase 6+
# ================================================================
# BRIGHTLOCAL_API_KEY=
# PSI_API_KEY=
# CALLRAIL_API_TOKEN=
# CALLRAIL_DEFAULT_ACCOUNT_ID=    # e.g. c509632936 — shared LLG account; per-client override possible
# METRICOOL_API_KEY=

# ================================================================
# GOOGLE ADS — v1.6, NOT in v1
# ================================================================
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_REDIRECT_URI=
